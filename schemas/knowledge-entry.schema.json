{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nimo.ai/schemas/knowledge-entry.schema.json",
  "title": "KnowledgeEntry",
  "description": "Schema for structured, validated knowledge entries across core knowledge domains.",
  "type": "object",
  "required": [
    "id",
    "version",
    "timestamp",
    "sourceProject",
    "domain",
    "status",
    "title",
    "summary",
    "content",
    "guidelines",
    "evidence",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^kno-[a-z0-9-]+$",
      "description": "Unique identifier (e.g., kno-20260916-spaced-repetition-guidelines)."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Version iteration for change tracking and rollback."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation or update."
    },
    "sourceProject": {
      "type": "string",
      "enum": [
        "nimo-core",
        "nimo-web",
        "prompt-aii",
        "nimo-assistant",
        "future-service"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "general",
        "education",
        "automation",
        "windows",
        "macos",
        "projects"
      ],
      "description": "Knowledge repository domain matching knowledge/ folder structure."
    },
    "status": {
      "type": "string",
      "enum": [
        "raw",
        "sanitized",
        "processed",
        "evaluated",
        "approved",
        "active",
        "archived",
        "rejected"
      ]
    },
    "title": {
      "type": "string",
      "description": "Clear title of the knowledge entry."
    },
    "summary": {
      "type": "string",
      "description": "High-level summary of the entry."
    },
    "content": {
      "type": "string",
      "description": "Full text or markdown-formatted instructional knowledge."
    },
    "guidelines": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Actionable dos and don'ts derived from this knowledge."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Confidence score based on empirical evidence and reviews."
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Backlinks to evaluations, citations, research, or evaluation IDs."
    },
    "metadata": {
      "type": "object",
      "required": [
        "sanitized",
        "tags"
      ],
      "additionalProperties": true,
      "properties": {
        "sanitized": {
          "type": "boolean",
          "enum": [true]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "approvedBy": {
          "type": "string",
          "description": "Designated reviewer or evaluation committee consensus hash."
        },
        "supersedes": {
          "type": "string",
          "description": "ID of previous knowledge entry that this replaces, if any."
        }
      }
    }
  }
}
