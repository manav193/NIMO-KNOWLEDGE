{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nimo.ai/schemas/feature-request.schema.json",
  "title": "FeatureRequest",
  "description": "Schema for formal feature requests originating from users or agent needs.",
  "type": "object",
  "required": [
    "id",
    "version",
    "timestamp",
    "sourceProject",
    "category",
    "status",
    "title",
    "summary",
    "useCase",
    "expectedBenefit",
    "priority",
    "evidence",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^feat-[a-z0-9-]+$",
      "description": "Unique identifier (e.g., feat-20260916-offline-cache)."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceProject": {
      "type": "string",
      "enum": [
        "nimo-core",
        "nimo-web",
        "prompt-aii",
        "nimo-assistant",
        "future-service"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "platform_capability",
        "integration",
        "developer_tooling",
        "student_experience",
        "security_compliance"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "raw",
        "sanitized",
        "processed",
        "evaluated",
        "approved",
        "active",
        "archived",
        "rejected"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "useCase": {
      "type": "string"
    },
    "expectedBenefit": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "feasibility": {
      "type": "string",
      "enum": [
        "trivial",
        "moderate",
        "complex",
        "research_needed"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "sanitized",
        "tags"
      ],
      "additionalProperties": true,
      "properties": {
        "sanitized": {
          "type": "boolean",
          "enum": [true]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "targetMilestone": {
          "type": "string"
        }
      }
    }
  }
}
