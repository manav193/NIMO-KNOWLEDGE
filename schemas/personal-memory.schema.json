{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://nimo.ai/schemas/personal-memory.schema.json",
  "title":"NIMO Personal Memory",
  "type":"object",
  "additionalProperties":false,
  "required":["id","version","status","encrypted","purpose","createdAt"],
  "properties":{
    "id":{"type":"string","pattern":"^mem-[a-z0-9-]+$"},
    "version":{"type":"integer","minimum":1},
    "status":{"type":"string","enum":["active","archived","deleted"]},
    "encrypted":{"const":true},
    "purpose":{"type":"string","enum":["personalization","task_continuity","user_requested_memory"]},
    "createdAt":{"type":"string","format":"date-time"},
    "expiresAt":{"type":["string","null"],"format":"date-time"},
    "keyReference":{"type":"string","description":"Opaque reference to an external key-management system; never the key itself."},
    "ciphertextReference":{"type":"string","description":"Opaque storage reference; plaintext memory is never stored here."},
    "consentId":{"type":"string","pattern":"^cons-[a-z0-9-]+$"}
  }
}